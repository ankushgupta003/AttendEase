{
  "name": "attendease-backend-postgres",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist-cjs/**",
      "node_modules/.prisma/**",
      "node_modules/@prisma/client/**",
      "prisma/**"
    ],
    "scripts": [
      "dist-cjs/**/*.js"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:exe": "npm run prisma:generate && tsc -p tsconfig.pkg.json && pkg -t node18-win-x64 -o dist/attendease-server.exe dist-cjs/index.js",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:template": "echo \"Not supported for Postgres. Use prisma:migrate and prisma:seed.\"",
    "prisma:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^7.0.3",
    "prisma": "^5.16.2",
    "tsx": "^4.15.6",
    "typescript": "^5.5.4",
    "pkg": "^5.8.1"
  }
}
